{
  "name": "@devascent/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "node --env-file-if-exists=../../.env scripts/dev.mjs",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@devascent/domain": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/throttler": "6.7.1",
    "cookie-parser": "1.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.20",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
