{
  "visible": [
    {
      "name": "three lists",
      "args": [
        [
          [1, 4, 5],
          [1, 3, 4],
          [2, 6]
        ]
      ],
      "expected": [1, 1, 2, 3, 4, 4, 5, 6]
    },
    {
      "name": "no lists",
      "args": [[]],
      "expected": []
    },
    {
      "name": "one empty list",
      "args": [[[]]],
      "expected": []
    }
  ],
  "hidden": [
    {
      "name": "one list of one node",
      "args": [[[1]]],
      "expected": [1]
    },
    {
      "name": "empty lists around one node",
      "args": [[[], [1], []]],
      "expected": [1]
    },
    {
      "name": "negative values and ties",
      "args": [[[-3, 0], [-3, -1], [5]]],
      "expected": [-3, -3, -1, 0, 5]
    },
    {
      "name": "one list after the other",
      "args": [
        [
          [1, 2, 3],
          [4, 5, 6]
        ]
      ],
      "expected": [1, 2, 3, 4, 5, 6]
    },
    {
      "name": "lists in reverse order",
      "args": [[[2], [1]]],
      "expected": [1, 2]
    }
  ]
}
