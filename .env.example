# Local PostgreSQL, started by the author with: docker compose up -d
POSTGRES_PASSWORD=<PASSWORD>
DATABASE_URL=postgres://devascent:<PASSWORD>@localhost:5432/devascent

# Where the web is served in development (Vite proxies /api to the API on port 3000).
APP_ORIGIN=http://localhost:5173

# GitHub OAuth App. Authorization callback URL: http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=<GITHUB_CLIENT_ID>
GITHUB_CLIENT_SECRET=<GITHUB_CLIENT_SECRET>

# Numeric GitHub user ids allowed to sign in, comma separated (https://api.github.com/users/<login> -> "id").
ALLOWED_GITHUB_IDS=<YOUR_NUMERIC_GITHUB_ID>

# Test-only login used by end-to-end tests. Refused in production.
AUTH_TEST_LOGIN=false